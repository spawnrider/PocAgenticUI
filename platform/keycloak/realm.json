{ "realm": "poc", "enabled": true,
  "clients": [
    { "clientId": "web-app", "publicClient": true, "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3001/*"], "webOrigins": ["+"], "attributes": {"pkce.code.challenge.method":"S256"} },
    { "clientId": "mobile-app", "publicClient": true, "standardFlowEnabled": true,
      "redirectUris": ["com.example.poc:/oauthredirect"], "attributes": {"pkce.code.challenge.method":"S256"} },
    { "clientId": "agent-service", "publicClient": false, "secret": "dev-secret", "serviceAccountsEnabled": true,
      "standardFlowEnabled": false },
    { "clientId": "agentgateway", "publicClient": false, "secret": "dev-secret", "bearerOnly": true }
  ],
  "clientScopes": [ { "name": "crm.read", "protocol": "openid-connect" }, { "name": "crm.write", "protocol": "openid-connect" } ],
  "users": [ { "username": "demo", "enabled": true, "email": "demo@example.com",
    "credentials": [ { "type": "password", "value": "demo", "temporary": false } ] } ]
}
